<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_14ccfnd" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.34.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.19.0">
  <bpmn:process id="person-mod-name" name="person-mod-name" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:executionListener class="de.guh.extension.startProcessInstance" event="start">
        <camunda:field name="system_alternativetargetname">
          <camunda:expression>${execution.getVariable('surname')}, ${execution.getVariable('givenname')}</camunda:expression>
        </camunda:field>
        <camunda:field name="system_descriptionsuffix">
          <camunda:expression> ${execution.getVariable('givenname')}, ${execution.getVariable('surname')}</camunda:expression>
        </camunda:field>
      </camunda:executionListener>
      <camunda:executionListener class="de.guh.extension.endProcessInstance" event="end" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="start" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_091zv2o</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end">
      <bpmn:incoming>Flow_11kb111</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="mail_to_initiator" name="mail to initiator" camunda:class="de.guh.extension.sendMailToInitiator">
      <bpmn:extensionElements>
        <camunda:executionListener class="de.guh.extension.updateProcessInstance" event="start">
          <camunda:field name="excludelocalvariables">
            <camunda:string>false</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_091zv2o</bpmn:incoming>
      <bpmn:outgoing>Flow_1uwglp0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_091zv2o" sourceRef="start" targetRef="mail_to_initiator" />
    <bpmn:serviceTask id="setnames" name="setnames" camunda:class="de.guh.extension.callRequestsCommand">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="givenname">${givenname}</camunda:inputParameter>
          <camunda:inputParameter name="actioninitiatorobjecttype">Account</camunda:inputParameter>
          <camunda:inputParameter name="actioninitiatoruniqueidpropertyname">globaluniqueid</camunda:inputParameter>
          <camunda:inputParameter name="actioninitiatoruniqueid">${execution.getVariable('processinitiatoruniqueid') != null ? execution.getVariable('processinitiatoruniqueid') :''}</camunda:inputParameter>
          <camunda:inputParameter name="surname">${surname}</camunda:inputParameter>
          <camunda:inputParameter name="gender">${gender}</camunda:inputParameter>
          <camunda:inputParameter name="salutation">${salutation}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:field name="category">
          <camunda:string>person</camunda:string>
        </camunda:field>
        <camunda:field name="command">
          <camunda:string>modify</camunda:string>
        </camunda:field>
        <camunda:field name="id">
          <camunda:expression>${processtargetuniqueid}</camunda:expression>
        </camunda:field>
        <camunda:executionListener class="de.guh.extension.updateProcessInstance" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1uwglp0</bpmn:incoming>
      <bpmn:outgoing>Flow_16yucrk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_16yucrk" sourceRef="setnames" targetRef="Gateway_0qgt5ig" />
    <bpmn:serviceTask id="mail_to_initiator_success" name="mail to initiator success" camunda:class="de.guh.extension.sendMailToInitiator">
      <bpmn:extensionElements>
        <camunda:executionListener class="de.guh.extension.updateProcessInstance" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1l0zc5b</bpmn:incoming>
      <bpmn:outgoing>Flow_0fmh83f</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="mail_to_person_success" name="mail to person success" camunda:class="de.guh.extension.sendMailToObject">
      <bpmn:extensionElements>
        <camunda:executionListener class="de.guh.extension.updateProcessInstance" event="end" />
        <camunda:field name="objecttype">
          <camunda:string>Person</camunda:string>
        </camunda:field>
        <camunda:field name="objectuniqueidpropertyname">
          <camunda:string>globaluniqueid</camunda:string>
        </camunda:field>
        <camunda:field name="objectuniqueid">
          <camunda:expression>${processtargetuniqueid}</camunda:expression>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1u1y5dp</bpmn:incoming>
      <bpmn:outgoing>Flow_11kb111</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_11kb111" sourceRef="mail_to_person_success" targetRef="end" />
    <bpmn:exclusiveGateway id="Gateway_0qgt5ig" default="Flow_0i1fxnq">
      <bpmn:incoming>Flow_16yucrk</bpmn:incoming>
      <bpmn:outgoing>Flow_1l0zc5b</bpmn:outgoing>
      <bpmn:outgoing>Flow_0i1fxnq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1l0zc5b" sourceRef="Gateway_0qgt5ig" targetRef="mail_to_initiator_success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${processinitiatorpersonglobauniqueid==currentresponsibleglobaluniqueid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="mail_to_resp_success" name="mail to resp success" camunda:class="de.guh.extension.sendMailToObject">
      <bpmn:extensionElements>
        <camunda:executionListener class="de.guh.extension.updateProcessInstance" event="end" />
        <camunda:field name="objecttype">
          <camunda:string>Person</camunda:string>
        </camunda:field>
        <camunda:field name="objectuniqueidpropertyname">
          <camunda:string>globaluniqueid</camunda:string>
        </camunda:field>
        <camunda:field name="objectuniqueid">
          <camunda:expression>${currentresponsibleglobaluniqueid}</camunda:expression>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0i1fxnq</bpmn:incoming>
      <bpmn:incoming>Flow_0fmh83f</bpmn:incoming>
      <bpmn:outgoing>Flow_1u1y5dp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0i1fxnq" sourceRef="Gateway_0qgt5ig" targetRef="mail_to_resp_success" />
    <bpmn:sequenceFlow id="Flow_0fmh83f" sourceRef="mail_to_initiator_success" targetRef="mail_to_resp_success" />
    <bpmn:sequenceFlow id="Flow_1u1y5dp" sourceRef="mail_to_resp_success" targetRef="mail_to_person_success" />
    <bpmn:sequenceFlow id="Flow_1uwglp0" sourceRef="mail_to_initiator" targetRef="setnames" />
  </bpmn:process>
