<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0stiz9p" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.34.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:process id="person-readytodelete" name="person ready to delete" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:executionListener class="de.guh.extension.startProcessInstance" event="start">
        <camunda:field name="system_alternativetargetname">
          <camunda:expression>${execution.getVariable('surname')}, ${execution.getVariable('givenname')}</camunda:expression>
        </camunda:field>
        <camunda:field name="system_descriptionsuffix">
          <camunda:expression>${execution.getVariable('givenname')}, ${execution.getVariable('surname')}</camunda:expression>
        </camunda:field>
      </camunda:executionListener>
      <camunda:executionListener class="de.guh.extension.endProcessInstance" event="end" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="start" name="start">
      <bpmn:outgoing>Flow_04xjqsy</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_04xjqsy" sourceRef="start" targetRef="mail_to_resp" />
    <bpmn:endEvent id="end" name="end">
      <bpmn:incoming>Flow_0yhw8pd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="mail_to_resp" name="mail to resp" camunda:class="de.guh.extension.sendMailToObject">
      <bpmn:extensionElements>
        <camunda:executionListener class="de.guh.extension.updateProcessInstance" event="end" />
        <camunda:field name="objecttype">
          <camunda:string>Person</camunda:string>
        </camunda:field>
        <camunda:field name="objectuniqueidpropertyname">
          <camunda:string>globaluniqueid</camunda:string>
        </camunda:field>
        <camunda:field name="objectuniqueid">
          <camunda:expression>${responsibleglobaluniqueid}</camunda:expression>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04xjqsy</bpmn:incoming>
      <bpmn:outgoing>Flow_0yhw8pd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0yhw8pd" sourceRef="mail_to_resp" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
