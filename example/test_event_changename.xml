    <!-- ============================================ -->
    <!-- EVENT DATA - PersonCandidate CHANGE_NAME     -->
    <!-- ============================================ -->
    <!-- Triggered when surname or givenname changes  -->
    <eventCollection dbuser="daccord" streamname="Lifecycle with PersonCandidate" streamid="1011">
        <nodeEvent>
            <!-- Event metadata -->
            <eventuniqueid>test-changename-001</eventuniqueid>
            <eventname>PersonCandidate</eventname>
            <labels>PersonCandidate</labels>
            <type>MODIFY_NODE</type>
            <timestamp>1724343599695</timestamp>

            <!-- PersonCandidate identification -->
            <!-- uniqueid must exist in the daccord database! -->
            <sourcenodeuniqueid>100052</sourcenodeuniqueid>
            <sourcenodename>Silas Wagner</sourcenodename>

            <!-- Property change: surname changed -->
            <propertyEvents>
                <propertyEvent>
                    <type>MODIFY_PROPERTY</type>
                    <name>surname</name>
                    <oldvalue>Wagner</oldvalue>
                    <newvalue>Wagner-Müller</newvalue>
                </propertyEvent>
            </propertyEvents>
        </nodeEvent>
    </eventCollection>


